# Copy to .env and rebuild. All values are optional.

# Backend address (default: http://localhost:8000)
VITE_API_URL=http://localhost:8000

# OAuth client ID of type "Chrome extension" from Google Cloud Console.
# Without it the "Continue with Google" button is hidden.
VITE_GOOGLE_CLIENT_ID=

# Public key that pins the extension ID so it matches the Google OAuth client.
VITE_EXTENSION_KEY=
# Optional: a "Web application" OAuth client whose redirect URI is
# https://<extension-id>.chromiumapp.org/ . Lets the user pick which Google account to use.
VITE_GOOGLE_WEB_CLIENT_ID=
